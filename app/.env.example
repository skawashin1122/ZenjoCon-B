# このファイルを .env という名前でコピーして、値を入れてください。
# .env は .gitignore に入っているので、Gitには含まれません。

# Gemini APIキー（空のままだと「テスト用の仮AI」で動きます）
GEMINI_API_KEY=
# 使うモデル名（提供状況に合わせて変更できます）
GEMINI_MODEL=gemini-3.5-flash-lite
# いつものモデルが混雑・エラーのときに使う予備
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# データベース（ローカルはSQLite、EC2ではPostgreSQL）
# 例: postgresql+psycopg://skima:パスワード@localhost/skima
DATABASE_URL=sqlite:///./skima.db

# 宮崎県の最低賃金（円）。宮崎労働局のサイトで最新の金額を確認して入れること
MIN_WAGE=1023

# ログイン状態の署名に使う秘密の文字列（長いランダムな文字列にする）
# 作り方: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# 教員画面のパスコード（EC2では必ず変更する）
TEACHER_PASSCODE=demo-teacher

# LINE Messaging API のチャネルアクセストークン（空なら LINE には送らない）
LINE_CHANNEL_ACCESS_TOKEN=
# 通知に載せるリンクの先頭（EC2ではHTTPSのURLにする）
BASE_URL=http://localhost:8000
# LINE の Webhook の署名チェックに使うチャネルシークレット
LINE_CHANNEL_SECRET=
# 友だち追加のURL（LINE Official Account Manager で確認。例: https://line.me/R/ti/p/@xxxx）
LINE_BOT_URL=

# 写真・音声を一時保存するS3バケット名（空ならパソコンのフォルダで代用）
# AWSの鍵はここに書かない（EC2の LabInstanceProfile を使う）
S3_BUCKET=
AWS_REGION=us-east-1

# 本選デモの直前だけ true にする（教員の試用結果画面に「デモ用に最初の状態へ戻す」ボタンが出る）
# 試用テストの記録も消えるので、先にCSVを保存してから
DEMO_MODE=false
