# このファイルを .env という名前でコピーして、値を入れてください。
# .env は .gitignore に入っているので、Gitには含まれません。

# Gemini APIキー（空のままだと「テスト用の仮AI」で動きます）
GEMINI_API_KEY=
# 使うモデル名（提供状況に合わせて変更できます）
GEMINI_MODEL=gemini-flash-latest

# データベース（ローカルはSQLite、EC2ではPostgreSQL）
# 例: postgresql+psycopg://skima:パスワード@localhost/skima
DATABASE_URL=sqlite:///./skima.db

# 宮崎県の最低賃金（円）。宮崎労働局のサイトで最新の金額を確認して入れること
MIN_WAGE=1023
